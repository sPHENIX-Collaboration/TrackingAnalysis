Universe           = vanilla
Notification       = Never
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
Initialdir         = ./
Executable         = $(Initialdir)/macro/runHFreco.sh
request_memory     = 1800MB
retry_request_memory_increase = RequestMemory + 400
retry_request_memory_max = 3600MB
Priority           = 20
job_lease_duration = 3600
OutDir             = $(Initialdir)/root/
Output             = $(Initialdir)/log/job-Data-$(Cluster)-$(Process).out
Error              = $(Initialdir)/log/job-Data-$(Cluster)-$(Process).err
Log                = /tmp/job-Data-$(Cluster)-$(Process).log
Arguments          = $(events) $(file) $(OutDir) $(skip)
Queue events file skip from fileLists/file_run53877_0.list
